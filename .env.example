# Optional. The scanner talks to PrizePicks and Underdog without keys.
# PrizePicks CS2 league id (265 as of 2026). Only change this if a live
# run returns zero PrizePicks props — they occasionally renumber leagues.
# PRIZEPICKS_CS2_LEAGUE_ID=265

# Seconds to wait for Underdog's full pick'em catalog (~10MB).
# UNDERDOG_TIMEOUT_SECONDS=90
